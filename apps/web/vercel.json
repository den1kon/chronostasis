{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node ../../scripts/deploy-build.mjs",
  "ignoreCommand": "node ../../scripts/ignore-vercel-build.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
