# No real secrets belong here. Docker Compose uses its own fixed, local-only
# development credentials and does not interpolate host database settings.
# These URLs are meaningful inside the Compose network. Host-run database
# commands need an explicitly supplied URL to a reachable local database.
DATABASE_URL=postgresql://chronostasis:chronostasis@db:5432/chronostasis
# Optional direct connection for migrations; empty falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=

# Clerk DEVELOPMENT instance (Clerk Dashboard -> API keys).
# Only the publishable key is exposed to the browser; never prefix a secret with VITE_.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Frontend API URL shown for the same Clerk instance, e.g.
# https://your-instance.clerk.accounts.dev (no trailing slash).
CLERK_ISSUER=
# Comma-separated frontend origins allowed to use session tokens.
# Include the actual local frontend port; use the same Clerk instance above.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:5174
# Local API listener, internal to the Compose network.
API_PORT=3001
