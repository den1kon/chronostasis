{
  "name": "chronostasis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "24.20.0",
    "pnpm": "10.34.7"
  },
  "scripts": {
    "dev": "pnpm --filter @chronostasis/web dev",
    "lint": "eslint . --max-warnings=0",
    "format:check": "gts lint '**/*.{js,mjs,jsx,ts,tsx}'",
    "format:fix": "gts fix '**/*.{js,mjs,jsx,ts,tsx}'",
    "typecheck": "tsc --build",
    "test:unit": "vitest run",
    "test:hooks": "node scripts/test-hooks.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:signed-out": "node scripts/run-e2e.mjs --signed-out",
    "hooks:install": "node scripts/install-hooks.mjs",
    "build": "pnpm --filter @chronostasis/web build",
    "db:generate": "pnpm --filter @chronostasis/db db:generate",
    "db:migrate": "pnpm --filter @chronostasis/db db:migrate",
    "db:seed": "pnpm --filter @chronostasis/db db:seed",
    "test:integration": "node scripts/test-integration.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "dev:api": "pnpm --filter @chronostasis/api-server dev"
  },
  "devDependencies": {
    "@clerk/testing": "2.2.50",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "gts": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
